{
  "name": "leonida-api",
  "version": "1.0.0",
  "private": true,
  "description": "GTA 6 Open Database & REST API — open, typed, Zod-validated data for Leonida and Vice City.",
  "license": "MIT",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate && next build",
    "start": "next start",
    "validate": "tsx scripts/validate-data.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run validate && npm run typecheck && npm run test"
  },
  "keywords": [
    "gta6",
    "gta-vi",
    "grand-theft-auto",
    "leonida",
    "vice-city",
    "api",
    "rest-api",
    "open-data",
    "nextjs",
    "zod"
  ],
  "dependencies": {
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
